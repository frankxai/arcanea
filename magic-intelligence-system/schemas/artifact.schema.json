{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/arcanea/magic-intelligence-system/schemas/artifact.schema.json",
  "title": "Arcanea Artifact",
  "description": "A canon-scoped magical interface with bounded capability, cost, counterplay, provenance, rights, and memory projection.",
  "type": "object",
  "required": [
    "id",
    "name",
    "status",
    "canonScope",
    "worldId",
    "artifactClass",
    "form",
    "provenance",
    "substrates",
    "attunement",
    "capabilities",
    "costs",
    "constraints",
    "failureModes",
    "counterplay",
    "agency",
    "bond",
    "combination",
    "narrative",
    "rights",
    "memory",
    "version",
    "createdAt",
    "updatedAt",
    "contributors"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": { "type": "string", "minLength": 3 },
    "epithet": { "type": "string", "minLength": 3 },
    "status": {
      "type": "string",
      "enum": ["experimental", "staging", "approved", "deprecated", "quarantined"]
    },
    "canonScope": {
      "type": "string",
      "enum": ["core", "world", "story", "community", "experimental"]
    },
    "worldId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "artifactClass": {
      "type": "string",
      "enum": ["focus", "key", "vessel", "bridge", "pact", "engine", "seal", "assembly"]
    },
    "form": {
      "type": "string",
      "enum": [
        "weapon",
        "armor",
        "attire",
        "jewelry",
        "instrument",
        "tool",
        "vessel",
        "text",
        "mask",
        "seed",
        "symbiote",
        "vehicle",
        "architecture",
        "network",
        "constellation",
        "other"
      ]
    },
    "provenance": {
      "type": "object",
      "required": ["originType", "makerId", "originWorldId", "originEvent", "age"],
      "additionalProperties": false,
      "properties": {
        "originType": {
          "type": "string",
          "enum": [
            "eldrian",
            "guardian-gift",
            "mortal-forged",
            "world-grown",
            "awakened-built",
            "shadow-corrupted",
            "unknown"
          ]
        },
        "makerId": { "type": ["string", "null"] },
        "originWorldId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "originEvent": { "type": "string", "minLength": 12 },
        "age": { "type": "string", "minLength": 3 }
      }
    },
    "substrates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+([:-][a-z0-9]+)*$" }
    },
    "attunement": {
      "type": "object",
      "required": [
        "primaryElements",
        "derivedDomains",
        "disciplines",
        "tier",
        "gate",
        "rank",
        "frequencies"
      ],
      "additionalProperties": false,
      "properties": {
        "primaryElements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["fire", "water", "earth", "wind", "void", "spirit"]
          }
        },
        "derivedDomains": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "disciplines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["attack", "defense", "summoning"] }
        },
        "tier": {
          "type": "string",
          "enum": ["light", "advanced", "greater", "sacred", "royal", "imperial", "divine"]
        },
        "gate": { "type": "integer", "minimum": 1, "maximum": 10 },
        "rank": {
          "type": "string",
          "enum": ["apprentice", "mage", "master", "archmage", "luminor"]
        },
        "frequencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "enum": [174, 285, 396, 417, 528, 639, 741, 852, 963, 1111]
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "required": ["id", "name", "grantMode", "description", "effect", "duration", "scope", "permanent"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "name": { "type": "string", "minLength": 3 },
          "grantMode": {
            "type": "string",
            "enum": ["amplify", "unlock", "store", "synthesize", "summon", "suppress", "transform"]
          },
          "description": { "type": "string", "minLength": 12 },
          "effect": { "type": "string", "minLength": 12 },
          "spellRefs": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
          },
          "duration": { "type": "string", "minLength": 2 },
          "scope": { "type": "string", "minLength": 2 },
          "permanent": { "type": "boolean" }
        }
      }
    },
    "costs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "trigger", "severity", "description"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "mana",
              "vitality",
              "memory",
              "time",
              "identity",
              "oath",
              "emotion",
              "relationship",
              "ecology",
              "material",
              "attention"
            ]
          },
          "trigger": { "type": "string", "enum": ["attunement", "activation", "sustained", "failure", "passive"] },
          "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
          "description": { "type": "string", "minLength": 12 }
        }
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type", "description"],
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "gate",
              "rank",
              "affinity",
              "location",
              "time",
              "oath",
              "charge",
              "material",
              "ritual",
              "knowledge",
              "consent",
              "ecology"
            ]
          },
          "description": { "type": "string", "minLength": 12 }
        }
      }
    },
    "failureModes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 12 }
    },
    "counterplay": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 12 }
    },
    "agency": {
      "type": "string",
      "enum": ["inert", "reactive", "echoing", "sentient", "sovereign"]
    },
    "bond": {
      "type": "object",
      "required": ["type", "attunementRite", "transferRule", "canRefuse"],
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["none", "bearer", "lineage", "oath", "paired", "community", "world"] },
        "attunementRite": { "type": "string", "minLength": 5 },
        "transferRule": { "type": "string", "minLength": 8 },
        "canRefuse": { "type": "boolean" }
      }
    },
    "combination": {
      "type": "object",
      "required": ["roles", "synergyTags", "incompatibleTags", "maxAssemblySize"],
      "additionalProperties": false,
      "properties": {
        "roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["core", "frame", "catalyst", "ward", "keystone"] }
        },
        "synergyTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "incompatibleTags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "maxAssemblySize": { "type": "integer", "minimum": 1, "maximum": 10 }
      }
    },
    "narrative": {
      "type": "object",
      "required": ["desire", "temptation", "fear", "consequence", "history"],
      "additionalProperties": false,
      "properties": {
        "desire": { "type": "string", "minLength": 12 },
        "temptation": { "type": "string", "minLength": 12 },
        "fear": { "type": "string", "minLength": 12 },
        "consequence": { "type": "string", "minLength": 12 },
        "history": { "type": "string", "minLength": 20 }
      }
    },
    "rights": {
      "type": "object",
      "required": ["inspirationIds", "similarityRisk", "originalMechanics", "prohibitedParallels", "reviewStatus"],
      "additionalProperties": false,
      "properties": {
        "inspirationIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "similarityRisk": { "type": "string", "enum": ["low", "medium", "high"] },
        "originalMechanics": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 12 } },
        "prohibitedParallels": { "type": "array", "items": { "type": "string", "minLength": 8 } },
        "reviewStatus": { "type": "string", "enum": ["pending", "cleared", "redesign-required"] }
      }
    },
    "memory": {
      "type": "object",
      "required": ["project", "namespace", "retrievalLabels", "authority"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "boolean" },
        "namespace": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "retrievalLabels": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "authority": { "type": "string", "const": "git-projection-only" }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "targetId"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
          "targetId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        }
      }
    },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "contributors": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "license": { "type": "string", "minLength": 3 }
  }
}
