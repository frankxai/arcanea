{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/frankxai/arcanea/magic-intelligence-system/schemas/world-magic-profile.schema.json",
  "title": "Arcanea World Magic Profile",
  "description": "A world-scoped manifestation of the locked Arcanea cosmology and magic grammar.",
  "type": "object",
  "required": [
    "worldId",
    "name",
    "status",
    "canonScope",
    "parentCosmology",
    "premise",
    "themes",
    "lockedInheritance",
    "domains",
    "artifactEcology",
    "worldRules",
    "portals",
    "contributionPolicy",
    "memory"
  ],
  "additionalProperties": false,
  "properties": {
    "worldId": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 3 },
    "workingTitle": { "type": "boolean" },
    "status": { "type": "string", "enum": ["experimental", "staging", "approved", "deprecated"] },
    "canonScope": { "type": "string", "enum": ["core", "world", "community", "experimental"] },
    "parentCosmology": { "type": "string", "const": "arcanea-core" },
    "premise": { "type": "string", "minLength": 30 },
    "themes": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 3 }
    },
    "lockedInheritance": {
      "type": "object",
      "required": ["cosmology", "elements", "gates", "ranks", "spellGrammar", "overridePolicy"],
      "additionalProperties": false,
      "properties": {
        "cosmology": { "type": "string", "const": ".arcanea/lore/CANON_LOCKED.md" },
        "elements": { "type": "string", "const": ".arcanea/lore/CANON_LOCKED.md#the-five-elements" },
        "gates": { "type": "string", "const": ".arcanea/lore/CANON_LOCKED.md#tier-2-the-ten-gates--arcanean-gods-locked" },
        "ranks": { "type": "string", "const": ".arcanea/lore/CANON_LOCKED.md#magic-ranks" },
        "spellGrammar": { "type": "string", "const": ".arcanea/lore/MAGIC_SYSTEM.md" },
        "overridePolicy": { "type": "string", "const": "forbidden" }
      }
    },
    "domains": {
      "type": "object",
      "required": ["enabledPrimary", "enabledDerived", "restricted", "localNames"],
      "additionalProperties": false,
      "properties": {
        "enabledPrimary": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "uniqueItems": true,
          "items": { "type": "string", "enum": ["fire", "water", "earth", "wind", "void", "spirit"] }
        },
        "enabledDerived": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "restricted": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" }
        },
        "localNames": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 2 }
        }
      }
    },
    "artifactEcology": {
      "type": "object",
      "required": [
        "prevalence",
        "acquisitionModes",
        "allowedClasses",
        "maximumPortableTier",
        "permanentImprinting",
        "gateDebtPolicy",
        "combinationRules",
        "institutions"
      ],
      "additionalProperties": false,
      "properties": {
        "prevalence": { "type": "string", "enum": ["mythic", "rare", "regulated", "common", "ubiquitous"] },
        "acquisitionModes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["discovery", "craft", "inheritance", "gift", "pact", "purchase", "service", "theft", "world-growth"]
          }
        },
        "allowedClasses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": ["focus", "key", "vessel", "bridge", "pact", "engine", "seal", "assembly"]
          }
        },
        "maximumPortableTier": {
          "type": "string",
          "enum": ["light", "advanced", "greater", "sacred", "royal", "imperial", "divine"]
        },
        "permanentImprinting": { "type": "boolean" },
        "gateDebtPolicy": { "type": "string", "enum": ["forbidden", "temporary", "legal-and-costly", "unregulated"] },
        "combinationRules": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 12 } },
        "institutions": { "type": "array", "items": { "type": "string", "minLength": 3 } }
      }
    },
    "worldRules": {
      "type": "array",
      "minItems": 2,
      "items": { "type": "string", "minLength": 15 }
    },
    "portals": {
      "type": "object",
      "required": ["crossWorldArtifacts", "importRule", "exportRule"],
      "additionalProperties": false,
      "properties": {
        "crossWorldArtifacts": { "type": "boolean" },
        "importRule": { "type": "string", "minLength": 12 },
        "exportRule": { "type": "string", "minLength": 12 }
      }
    },
    "contributionPolicy": {
      "type": "object",
      "required": ["remixable", "license", "defaultScope", "canonRoute", "creatorAttributionRequired"],
      "additionalProperties": false,
      "properties": {
        "remixable": { "type": "boolean" },
        "license": { "type": "string", "minLength": 3 },
        "defaultScope": { "type": "string", "enum": ["world", "community", "experimental"] },
        "canonRoute": { "type": "string", "const": "experimental->staging->human-approval->approved" },
        "creatorAttributionRequired": { "type": "boolean", "const": true }
      }
    },
    "memory": {
      "type": "object",
      "required": ["project", "namespace", "defaultQueryStatus", "authority"],
      "additionalProperties": false,
      "properties": {
        "project": { "type": "boolean" },
        "namespace": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "defaultQueryStatus": { "type": "string", "const": "approved" },
        "authority": { "type": "string", "const": "git-projection-only" }
      }
    }
  }
}
