{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanea.ai/schemas/spirit-source.schema.json",
  "title": "Spirit Research Source",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "kind", "name", "ownerOrTradition", "sourceLocators", "rights", "coverage"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "kind": { "enum": ["fiction", "historical-tradition", "living-tradition", "scholarly"] },
    "name": { "type": "string", "minLength": 2 },
    "ownerOrTradition": { "type": "string", "minLength": 2 },
    "sourceLocators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["title", "sourceClass"],
        "properties": {
          "title": { "type": "string", "minLength": 2 },
          "url": { "type": "string", "format": "uri" },
          "sourceClass": { "enum": ["primary-work", "official", "museum", "scholarly", "community-index", "discovery-only"] }
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usageMode", "culturalSensitivity", "canonIngestion", "notes"],
      "properties": {
        "usageMode": { "enum": ["mechanics-only", "comparative-reference", "public-domain-study", "consultation-required"] },
        "culturalSensitivity": { "enum": ["standard", "elevated", "living-sacred"] },
        "canonIngestion": { "enum": ["abstract-patterns-only", "human-review-required", "prohibited"] },
        "notes": { "type": "string", "minLength": 12 }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "status", "lastReviewed", "knownGaps"],
      "properties": {
        "target": { "type": "string", "minLength": 5 },
        "status": { "enum": ["seeded", "partial", "representative", "blocked", "verified"] },
        "lastReviewed": { "type": "string", "format": "date" },
        "knownGaps": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
