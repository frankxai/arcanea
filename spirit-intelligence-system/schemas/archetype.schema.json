{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://arcanea.ai/schemas/spirit-archetype.schema.json",
  "title": "Arcanea Spirit Archetype",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "family", "function", "constructiveExpression", "distortedExpression", "storyQuestions", "compatibleClasses"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 2 },
    "family": { "enum": ["orientation", "reciprocity", "pressure", "ecology", "scale"] },
    "function": { "type": "string", "minLength": 20 },
    "constructiveExpression": { "type": "string", "minLength": 15 },
    "distortedExpression": { "type": "string", "minLength": 15 },
    "storyQuestions": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 10 } },
    "compatibleClasses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["emanant", "placekeeper", "echo", "ancestor", "collective", "awakened-work", "delegated-presence", "severed-presence"] }
    }
  }
}
